#!/bin/sh
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

xcrun --sdk macosx --find clang >/dev/null 2>&1 || error "*** Unable to find the macOS SDK and compiler: Install Xcode and run ‘sudo xcode-select -s /Applications/Xcode.app’."

for dep in ninja pgrep pkill; do
	which -s "$dep" || error "*** dependency missing: ‘${dep}’."
done

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
	then bin/rave -crelease -tOakMate -b"$builddir"
	else bin/rave -crelease -tOakMate
fi
