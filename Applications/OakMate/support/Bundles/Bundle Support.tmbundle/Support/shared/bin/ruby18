#!/bin/sh

# Bundle items written for ruby 1.8 are run with a modern ruby (see ruby20).
# Options that only exist in ruby 1.8 are removed.

options=1
for arg; do
	shift
	if [ $options = 1 ]; then
		case "$arg" in
			-rjcode|-Ku|-KU) continue ;;
			--|[!-]*) options=0 ;;
		esac
	fi
	set -- "$@" "$arg"
done

exec "$(dirname "$0")/ruby20" "$@"
