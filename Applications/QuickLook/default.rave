target "OakMateQLRender" {
	require OakFoundation OakSystem buffer bundles cf file io ns plist scope settings theme
	sources src/*.mm
	frameworks AppKit OSAKit
}

target "OakMateQLPreview" {
	require OakMateQLRender

	capture APP_VERSION "grep -om1 '^## .* (v.*)$' '${dir}/../OakMate/about/Changes.md'|sed 's/.*(v\\(.*\))/\\1/'"

	config "debug" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=true'"
	}

	config "release" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=false'"
	}

	expand CS_ENTITLEMENTS "${dir}/Preview/Entitlements.plist"

	add PLIST_FLAGS "-dAPP_VERSION='${APP_VERSION}'"
	add CS_FLAGS    "--entitlements '${CS_ENTITLEMENTS}'"
	add LN_FLAGS    "-fapplication-extension -e _NSExtensionMain"

	prefix "${target}.appex/Contents"
	files Preview/Info.plist "."

	sources Preview/*.mm
	executable "MacOS/${target}"
	frameworks QuickLookUI UniformTypeIdentifiers
}

target "OakMateQLThumbnail" {
	require OakMateQLRender

	capture APP_VERSION "grep -om1 '^## .* (v.*)$' '${dir}/../OakMate/about/Changes.md'|sed 's/.*(v\\(.*\))/\\1/'"

	config "debug" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=true'"
	}

	config "release" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=false'"
	}

	expand CS_ENTITLEMENTS "${dir}/Thumbnail/Entitlements.plist"

	add PLIST_FLAGS "-dAPP_VERSION='${APP_VERSION}'"
	add CS_FLAGS    "--entitlements '${CS_ENTITLEMENTS}'"
	add LN_FLAGS    "-fapplication-extension -e _NSExtensionMain"

	prefix "${target}.appex/Contents"
	files Thumbnail/Info.plist "."

	sources Thumbnail/*.mm
	executable "MacOS/${target}"
	frameworks QuickLookThumbnailing
}
